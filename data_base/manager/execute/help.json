          },
          {
            "id": "insert-and-check-generated-key",
            "label": "اجرای INSERT و بررسی Success، نوع Long، مقدار key و callback",
            "kind": "step",
            "parentId": "execute-insert-generated-key"
          },
          {
            "id": "verify-inserted-row",
            "label": "تأیید اینکه generated key ردیف درج‌شده را پیدا می‌کند",
            "kind": "step",
            "parentId": "execute-insert-generated-key"
          },
          {
            "id": "cleanup-insert-test-table",
            "label": "حذف جدول INSERT در finally و حفظ خطای اصلی در صورت شکست cleanup",
            "kind": "step",
            "parentId": "execute-insert-generated-key"
          },
          {
            "id": "create-ddl-test-table",
            "label": "ساخت جدول DDL از مسیر manager:execute",
            "kind": "step",
            "parentId": "execute-ddl"
          },
          {
            "id": "verify-ddl-result",
            "label": "بررسی ExecuteResult.Success(true) و callback دقیقاً یک‌باره",
            "kind": "step",
            "parentId": "execute-ddl"
          },
          {
            "id": "cleanup-ddl-test-table",
            "label": "حذف جدول DDL در finally و حفظ خطای اصلی در صورت شکست cleanup",
            "kind": "step",
            "parentId": "execute-ddl"
          },
          {
            "id": "record-gradle-junit-result",
            "label": "ثبت نتیجهٔ Gradle و شمارش passed، failed و skipped",
            "kind": "step",
            "parentId": "execute-finalization"
          },
          {
            "id": "close-result-set-and-restore-config",
            "label": "بستن ResultSet و بازگرداندن تنظیمات قبلی پایگاه داده در هر تست",
            "kind": "step",
            "parentId": "execute-finalization"
          }
        ],
        "expectedMigrations": [],
        "verificationCategories": [
          "اتصال به MySQL",
          "اتصال پارامترهای JDBC",
          "رفت‌وبرگشت مقدارهای نوع‌دار",
          "پارامتر null",
          "تعداد فراخوانی callback",
          "چرخهٔ عمر ResultSet",
          "INSERT و generated key",
          "اجرای DDL از مسیر manager:execute",
          "cleanup جدول‌های اختصاصی",
          "ثبت runtime baseline"
        ],
        "runtime": {
          "type": "test-runtime-json",
          "schemaVersion": 2
        }
      },
      "runner": {
        "type": "gradle-test",
        "testFilter": "gog.my_project.data_base.manager.execute.manager.QueryExecuteMySqlIntegrationTest"
      },
      "parameters": [
        {
          "id": "db-host",
          "label": "میزبان پایگاه داده",
          "type": "text",
          "required": true,
          "default": "127.0.0.1",
          "secret": false,
          "validation": {
            "notBlank": true
          },
          "binding": {
            "type": "gradle-project-property",
            "name": "execute.test.db.host"
          }
        },
        {
          "id": "db-port",
          "label": "درگاه پایگاه داده",
          "type": "number",
          "required": true,
          "default": 3306,
          "secret": false,
          "minimum": 1,
          "maximum": 65535,
          "binding": {
            "type": "gradle-project-property",
            "name": "execute.test.db.port"
          }
        },
        {
          "id": "db-name",
          "label": "نام پایگاه داده",
          "type": "text",
          "required": true,
          "default": "kotlin_db",
          "secret": false,
          "validation": {
            "notBlank": true
          },
          "binding": {
            "type": "gradle-project-property",
            "name": "execute.test.db.name"
          }
        },
        {
          "id": "db-username",
          "label": "نام کاربری",
          "type": "text",
          "required": true,
          "default": "root",
          "secret": false,
          "validation": {
            "notBlank": true
          },
          "binding": {
            "type": "gradle-project-property",
            "name": "execute.test.db.username"
          }
        },
        {
          "id": "db-password",
          "label": "گذرواژه",
          "type": "password",
          "required": false,
          "allowEmpty": true,
          "secret": true,
          "binding": {
            "type": "gradle-project-property",
            "name": "execute.test.db.password"
          }
        }
      ],
      "report": {
        "type": "gradle-html",
        "path": "build/reports/tests/test"
      }
    }
  ]
